#!/usr/bin/env bash
# 47 上的受限 JAR 接收端: 远程构建机 (canada-mini) 的部署密钥只能跑这一个程序。
#
# 装法: /usr/local/sbin/cretas-stage-receive (install-server-scripts.sh 管), 并在
# /root/.ssh/authorized_keys 里给那把密钥加
#     restrict,command="/usr/local/sbin/cretas-stage-receive" ssh-ed25519 AAAA... cretas-remote-build@canada-mini
# restrict 关掉 pty / 端口转发 / agent 转发 / X11; command= 让客户端请求的命令只进
# SSH_ORIGINAL_COMMAND, 由这里白名单解析。所以这把钥匙【拿不到 shell】, 只能:
#
#   has   <sha256>          缓存里已有且哈希对 ⇒ 0, 否则 1
#   stage <sha256> <bytes>  从 stdin 收一个 jar, 写到临时名, 校验 字节数 + sha256 +
#                           unzip -tqq, 0444 后原子 mv 进 sha256 缓存。与
#                           stage-backend-artifact.sh 落盘的位置、权限、校验完全相同,
#                           所以之后 Windows 侧 stage 直接命中 "already staged"。
#   bench <bytes>           从 stdin 读并丢弃, 只回报字节数 (量带宽用, 不落盘)
#
# 它【不】安装 jar、不重启服务、不碰 nginx —— 部署仍只走 deploy-backend.sh。
# 退出码: 0 成功 / 1 校验失败或未命中 / 2 用法错
set -euo pipefail
umask 077

CACHE_DIR=${CRETAS_REMOTE_JAR_CACHE_DIR:-/www/wwwroot/cretas/release-cache/sha256}
LOG=${CRETAS_STAGE_RECEIVE_LOG:-/www/wwwroot/cretas/release-cache/stage-receive.log}
MAX_BYTES=$((400 * 1024 * 1024))
MIN_FREE_KB=$((2 * 1024 * 1024))

log() {
    printf '%s %s client=%s\n' "$(date '+%F %T')" "$*" "$(printf '%s' "${SSH_CLIENT:-local}" | awk '{print $1}')" >> "$LOG" 2>/dev/null || true
}

die() {
    local code=$1; shift
    log "REFUSED $*"
    echo "cretas-stage-receive: $*" >&2
    exit "$code"
}

is_sha256() {
    [ "${#1}" = 64 ] || return 1
    case "$1" in *[!0123456789abcdef]*) return 1 ;; esac
}

is_uint() {
    [ -n "$1" ] || return 1
    case "$1" in *[!0123456789]*) return 1 ;; esac
}

# 只按空白切分, 不经过 eval / shell: 客户端字符串永远只是数据。
read -r -a ARGS <<< "${SSH_ORIGINAL_COMMAND:-}"
[ "${#ARGS[@]}" -ge 1 ] || die 2 "missing command (allowed: has|stage|bench)"

case "${ARGS[0]}" in
    has)
        [ "${#ARGS[@]}" = 2 ] && is_sha256 "${ARGS[1]}" || die 2 "usage: has <sha256>"
        target="$CACHE_DIR/${ARGS[1]}.jar"
        [ -f "$target" ] || exit 1
        [ "$(sha256sum "$target" | awk '{print $1}')" = "${ARGS[1]}" ] || exit 1
        echo "present $target"
        ;;
    stage)
        [ "${#ARGS[@]}" = 3 ] && is_sha256 "${ARGS[1]}" && is_uint "${ARGS[2]}" \
            || die 2 "usage: stage <sha256> <bytes>"
        sha=${ARGS[1]}; bytes=${ARGS[2]}
        [ "$bytes" -gt 0 ] && [ "$bytes" -le "$MAX_BYTES" ] || die 2 "size out of range: $bytes"
        mkdir -p "$CACHE_DIR"
        chmod 700 "$CACHE_DIR"
        target="$CACHE_DIR/$sha.jar"
        if [ -f "$target" ] && [ "$(sha256sum "$target" | awk '{print $1}')" = "$sha" ]; then
            cat > /dev/null
            log "ALREADY sha=$sha"
            echo "already-staged $target"
            exit 0
        fi
        free_kb=$(df -Pk "$CACHE_DIR" | awk 'NR==2 {print $4}')
        is_uint "$free_kb" && [ "$free_kb" -ge "$MIN_FREE_KB" ] || die 1 "insufficient disk: ${free_kb:-?}KB free"
        # 点开头且不以 .jar 结尾: 不会被 stage-backend-artifact.sh 选成 rsync 基准。
        tmp="$CACHE_DIR/.$sha.recv.$$"
        trap 'rm -f "$tmp"' EXIT
        started=$(date +%s)
        # 多读 1 字节: 发多了也能被字节数校验挡住, 而不是悄悄截断。
        head -c $((bytes + 1)) > "$tmp"
        got=$(stat -c %s "$tmp")
        [ "$got" = "$bytes" ] || die 1 "byte count mismatch sha=$sha want=$bytes got=$got"
        actual=$(sha256sum "$tmp" | awk '{print $1}')
        [ "$actual" = "$sha" ] || die 1 "sha256 mismatch want=$sha got=$actual"
        unzip -tqq "$tmp" >/dev/null 2>&1 || die 1 "jar integrity (unzip -tqq) failed sha=$sha"
        chmod 0444 "$tmp"
        mv -f "$tmp" "$target"
        trap - EXIT
        log "STAGED sha=$sha bytes=$bytes seconds=$(( $(date +%s) - started ))"
        echo "staged $target bytes=$bytes"
        ;;
    bench)
        [ "${#ARGS[@]}" = 2 ] && is_uint "${ARGS[1]}" || die 2 "usage: bench <bytes>"
        [ "${ARGS[1]}" -le "$MAX_BYTES" ] || die 2 "bench size out of range"
        got=$(head -c "${ARGS[1]}" | wc -c | tr -d '[:space:]')
        log "BENCH bytes=$got"
        echo "bench bytes=$got"
        ;;
    *)
        die 2 "command not allowed: ${ARGS[0]}"
        ;;
esac
