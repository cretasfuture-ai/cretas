{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "执行线回执",
  "type": "object",
  "required": ["id", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,63}$" },
    "status": { "enum": ["completed", "blocked"] },
    "branch": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pr": { "type": "integer", "minimum": 1 },
    "changed_files": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "exit_code", "executed_count", "log_path"],
        "properties": {
          "command": { "type": "string", "pattern": "\\S" },
          "exit_code": { "type": "integer", "enum": [0] },
          "executed_count": { "type": "integer", "minimum": 1 },
          "log_path": { "type": "string", "pattern": "\\S" }
        }
      }
    },
    "reason": { "type": "string", "pattern": "\\S" }
  },
  "if": { "properties": { "status": { "const": "completed" } } },
  "then": { "required": ["branch", "commit", "pr", "changed_files", "tests"] },
  "else": { "required": ["reason"] }
}
