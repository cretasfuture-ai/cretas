# Set in the operator's environment or a secrets manager. Never commit real values.
BLACKLAKE_BASE_URL=https://liteweb.blacklake.cn
BLACKLAKE_TENANT_ID=
BLACKLAKE_SOURCE_FACTORY_ID=
BLACKLAKE_PHONE=
BLACKLAKE_PASSWORD=
# Optional Windows CurrentUser encrypted credential file (outside repository).
BLACKLAKE_SECRET_FILE=
# Dedicated PoC database; runtime role MUST NOT be superuser or BYPASSRLS.
BLACKLAKE_DATABASE_URL=
# Private Redis, TLS + ACL in production. Contains bearer token (24h local retention).
BLACKLAKE_REDIS_URL=
# Explicit authorization for restricted raw payload storage, including personal data.
BLACKLAKE_ALLOW_RAW_STORAGE=false
